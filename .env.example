# Copy to .env and fill in. Never commit .env.

# --- OpenAI (photo evaluation) ---
OPENAI_API_KEY=
# Any vision-capable model. Cheap ones are plenty for this job.
OPENAI_MODEL=gpt-4.1-mini

# --- Email (SMTP + app password) ---
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Defaults to SMTP_USER if left blank
SMTP_FROM=
# Comma separated. Can also be edited in the web UI.
DIGEST_TO=you@example.com,partner@example.com

# --- Server ---
SCOUT_HOST=0.0.0.0
SCOUT_PORT=8080
# Leave blank for no auth (LAN only!). Set both to enable HTTP basic auth.
SCOUT_AUTH_USER=
SCOUT_AUTH_PASSWORD=

# --- Storage ---
# Defaults to ~/.appart-scout/scout.db
SCOUT_DB_PATH=
