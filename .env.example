# Copy to .env and fill in. Never commit .env.
#
# Everything in this file except the SCOUT_* block can also be set on the
# Settings page, which takes precedence. Setting it here means it survives a
# database reset; setting it in the UI means changing a password does not need
# SSH and a service restart. Fill in whichever you prefer — or neither, and use
# the UI only.

# --- OpenAI (photo evaluation) ---
OPENAI_API_KEY=
# Any vision-capable model. Cheap ones are plenty for this job.
OPENAI_MODEL=gpt-4.1-mini

# --- Email (SMTP + app password) ---
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Defaults to SMTP_USER if left blank
SMTP_FROM=
# Comma separated. Can also be edited in the web UI.
DIGEST_TO=you@example.com,partner@example.com

# --- IMAP (the `mailbox` source: saved-search alert emails) ---
# ImmoScout24 / Homegate / Newhome / Comparis block scrapers but will email you
# their new listings. Create a saved search on each portal, point its alerts at
# this mailbox, and enable the `mailbox` source. Mail is only ever read.
# Use a dedicated address or a dedicated folder - everything in IMAP_FOLDER from
# a recognised portal sender gets parsed.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
# Gmail: an App Password, not your account password.
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SSL=true

# --- Server ---
SCOUT_HOST=0.0.0.0
SCOUT_PORT=8080
# Leave blank for no auth (LAN only!). Set both to enable HTTP basic auth.
SCOUT_AUTH_USER=
SCOUT_AUTH_PASSWORD=

# --- Storage ---
# Defaults to ~/.appart-scout/scout.db
SCOUT_DB_PATH=
